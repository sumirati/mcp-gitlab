# GitLab MCP Server Configuration
# Copy this file to .env and adjust values for your local environment

# Required: GitLab Personal Access Token with `api` scope
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-your_personal_access_token_here

# Optional: Base API URL for your self-hosted or SaaS GitLab instance (defaults to https://gitlab.com/api/v4)
GITLAB_API_URL=https://gitlab.example.com/api/v4
